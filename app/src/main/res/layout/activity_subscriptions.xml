<?xml version="1.0" encoding="utf-8"?>

    <!-- ============================================================
         MY SUBSCRIPTIONS SCREEN

         Displays podcasts saved by the user.

         Features:
         1. Screen title
         2. Back to Search button
         3. Subscription information
         4. Subscribed podcast list
         ============================================================ -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/subscriptionsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ========================================================
         SCREEN TITLE
         ======================================================== -->

    <TextView
        android:id="@+id/textViewSubscriptionsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Subscriptions"
        android:textSize="28sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <!-- ========================================================
         BACK TO SEARCH BUTTON
         ======================================================== -->

    <Button
        android:id="@+id/buttonBackToSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Search" />

    <!-- ========================================================
         INFORMATION MESSAGE
         ======================================================== -->

    <TextView
        android:id="@+id/textViewEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your subscribed podcasts will appear here."
        android:textSize="16sp"
        android:paddingBottom="12dp" />

    <!-- ========================================================
         SUBSCRIBED PODCAST LIST
         ======================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSubscriptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

