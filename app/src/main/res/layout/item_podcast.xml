<?xml version="1.0" encoding="utf-8"?>

<!-- ============================================================
     SUPERPODCAST PODCAST RESULT ITEM

     Displays:
     1. Podcast artwork
     2. Podcast title
     3. Podcast creator
     4. Subscribe button
     5. Remove Subscription button

     Existing IDs are preserved so the current
     PodcastAdapter.kt continues to work.
     ============================================================ -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:elevation="2dp">

    <!-- ========================================================
         PODCAST ARTWORK
         ======================================================== -->

    <ImageView
        android:id="@+id/imageViewArtwork"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:contentDescription="Podcast artwork"
        android:scaleType="centerCrop" />

    <!-- ========================================================
         PODCAST INFORMATION
         ======================================================== -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <!-- ====================================================
             PODCAST TITLE
             ==================================================== -->

        <TextView
            android:id="@+id/textViewPodcastTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Podcast Title"
            android:textColor="#1F2937"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- ====================================================
             PODCAST CREATOR
             ==================================================== -->

        <TextView
            android:id="@+id/textViewArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Podcast Creator"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- ====================================================
             SUBSCRIBE BUTTON
             ==================================================== -->

        <Button
            android:id="@+id/buttonSubscribe"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="Subscribe"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <!-- ====================================================
             REMOVE SUBSCRIPTION BUTTON

             This button will be connected to
             SubscriptionsActivity in the next step.
             ==================================================== -->

        <Button
            android:id="@+id/buttonRemoveSubscription"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:text="Remove Subscription"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
