<?xml version="1.0" encoding="utf-8"?>

<!-- ============================================================
     SUPERPODCAST SUBSCRIPTION ITEM

     PURPOSE:
     Displays one subscribed podcast in the
     My Subscriptions RecyclerView.

     Displays:
     1. Podcast artwork
     2. Podcast title
     3. Podcast creator
     ============================================================ -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="#FFFFFF">

    <!-- ========================================================
         PODCAST ARTWORK
         ======================================================== -->

    <ImageView
        android:id="@+id/imageViewArtwork"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:contentDescription="Podcast artwork" />

    <!-- ========================================================
         PODCAST INFORMATION
         ======================================================== -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ====================================================
             PODCAST TITLE
             ==================================================== -->

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Podcast Title"
            android:textColor="#1F2937"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- ====================================================
             PODCAST CREATOR
             ==================================================== -->

        <TextView
            android:id="@+id/textViewArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Podcast Creator"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>