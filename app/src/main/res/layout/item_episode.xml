<?xml version="1.0" encoding="utf-8"?>

<!-- ============================================================
     SUPERPODCAST EPISODE ITEM

     Displays one podcast episode.

     Features:
     1. Episode title
     2. Publication date
     3. Episode description
     4. Play button
     ============================================================ -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="14dp"
    android:elevation="2dp">

    <!-- ========================================================
         EPISODE TITLE
         ======================================================== -->

    <TextView
        android:id="@+id/textViewEpisodeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Episode Title"
        android:textColor="#1F2937"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- ========================================================
         EPISODE PUBLICATION DATE
         ======================================================== -->

    <TextView
        android:id="@+id/textViewEpisodeDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Publication Date"
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <!-- ========================================================
         EPISODE DESCRIPTION
         ======================================================== -->

    <TextView
        android:id="@+id/textViewEpisodeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Episode description"
        android:textColor="#374151"
        android:textSize="14sp"
        android:maxLines="4"
        android:ellipsize="end" />

    <!-- ========================================================
         PLAY BUTTON
         ======================================================== -->

    <Button
        android:id="@+id/buttonPlayEpisode"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:text="▶ Play Episode"
        android:textSize="13sp"
        android:textAllCaps="false" />

</LinearLayout>